# Django
SECRET_KEY=replace-with-a-secure-random-string
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.137.1

# HTTP pilot / reverse proxy
CSRF_TRUSTED_ORIGINS=http://192.168.137.1
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Database
DB_NAME=sbc_attendance
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=5432

# SMS (Movider)
MOVIDER_API_KEY=
MOVIDER_API_SECRET=
HR_PHONE_NUMBER=

# Email (Gmail SMTP)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
HR_EMAIL=

# WiFi / network access control
# Comma-separated exact IPs, IPv4 prefixes (ending in .), or CIDR blocks.
ALLOWED_IP_RANGES=127.0.0.1,192.168.1.,192.168.137.
# Set to True only for local development/testing. Never enable in production.
WIFI_BYPASS=False
# Only enable this when running behind a trusted reverse proxy that sets
# X-Forwarded-For. Otherwise clients can spoof their IP address.
TRUST_X_FORWARDED_FOR=False
